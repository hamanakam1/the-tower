# The Tower environment
# optional bearer token. Guards every mutating request and the WebSocket.
# Reads (the dashboard's live view) stay open; writes do not happen without it.
TOWER_TOKEN=
TOWER_RATE_LIMIT=0      # requests per minute per IP (0 = off)
TOWER_CORS_ORIGINS=     # comma-separated allowlist, empty = no cross-origin
TOWER_DB_PATH=~/.the-tower/tower.sqlite